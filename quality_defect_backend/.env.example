# Backend runtime
PORT=8000
REACT_APP_NODE_ENV=development

# CORS / URLs (used for allowed origins + docs)
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_FRONTEND_URL=http://localhost:3000

# WebSocket URL is used by the frontend; backend mounts WS under /ws.
# Example: ws://localhost:8000/ws
REACT_APP_WS_URL=ws://localhost:8000/ws

# API base used by frontend axios (often same as backend URL)
REACT_APP_API_BASE=http://localhost:8000

# Optional logging configuration
REACT_APP_LOG_LEVEL=info

# Optional: trust proxy if running behind reverse proxy
REACT_APP_TRUST_PROXY=false

# Healthcheck path (if used by infra)
REACT_APP_HEALTHCHECK_PATH=/health
